# Normalisasi line ending: pakai LF agar aman di server Linux
* text=auto eol=lf

# Script shell & unit systemd WAJIB berakhir LF
*.sh      text eol=lf
*.service text eol=lf

# Python / JS juga LF
*.py text eol=lf
*.js text eol=lf

# File biner (jangan diubah)
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
