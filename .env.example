DISCORD_TOKEN=your-discord-token-here
DISCORD_TOKEN2=your-second-discord-token-here
ACCOUNT_1_NAME=Akun 1
ACCOUNT_2_NAME=Akun 2
FLASK_SECRET_KEY=change-me
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
DATA_DIR=data
AUTO_START_ACCOUNT=false
# Jika true, semua automation + log lama dihapus setiap start (jangan aktifkan di server 24/7)
RESET_ON_START=false

# === Bot Telegram (monitoring dari HP) — opsional ===
# Buat bot via @BotFather lalu isi dua baris di bawah.
# TELEGRAM_CHAT_ID hanya boleh milik Anda (whitelist) — selain itu akan DIABAIKAN.
# Cara dapat CHAT_ID: chat @userinfobot di Telegram.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
